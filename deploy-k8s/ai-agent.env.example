# Copy to ai-agent.env (or run deploy-k8s/setup-env.sh) before creating the
# k8s secret. Real values are generated locally and never committed.

# Optional cloud LLM fallback (leave blank to use Ollama via LITELLM_BASE_URL only).
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
LANGCHAIN_MODEL=openai:claude-sonnet-5
OLLAMA_BASE_URL=http://host.minikube.internal:11434
LITELLM_BASE_URL=http://litellm-gateway.virtual.consul:4000/v1
OBO_ROLE_NAME=agent-runtime
BYPASS_AUTH_TOKEN_EXCHANGE=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Manifest overrides this; keep in sync so a local run still hits the PEP.
USER_MCP_URL=http://litellm-gateway.virtual.consul:4000/user_mcp/mcp
ACTOR_TOKEN_PATH=/vault/secrets/actor-token
TOKEN_EXCHANGE_URL=http://token-exchange.virtual.consul/v1/identity/obo-token
TOKEN_EXCHANGE_TIMEOUT_SECONDS=10
# Generous margin for a slow local LLM / tool round-trip
MCP_TOOL_CALL_TIMEOUT_SECONDS=120
