IDENTITY_BROKER_KEYCLOAK_URL=http://keycloak.virtual.consul
IDENTITY_BROKER_KEYCLOAK_REALM=demo
IDENTITY_BROKER_KEYCLOAK_TOKEN_EXCHANGE_AUDIENCE=user-mcp
IDENTITY_BROKER_OBO_CLIENT_ID=token-exchange
# Populated by infra/local-minikube/keycloak.sh (run via `make keycloak`),
# which keeps this in sync with the secret baked into the imported realm.
IDENTITY_BROKER_OBO_CLIENT_SECRET=41a647e8de34096019d227b4bede8ad337589d5a6b45687d
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
VAULT_ADDR=https://vault.vault.svc.cluster.local:8200
# The Vault-signed actor token is verified against Vault's published OIDC keys
# (<issuer>/.well-known/keys, fetched over TLS with the CA below). The audience is
# the client_id of Vault's identity/oidc/role/agent-role (pinned in configure.sh).
IDENTITY_BROKER_VAULT_CA_BUNDLE=/etc/vault-ca/ca.crt
IDENTITY_BROKER_ACTOR_ISSUER=https://vault.vault.svc.cluster.local:8200/v1/identity/oidc
IDENTITY_BROKER_ACTOR_AUDIENCE=agent-actor
