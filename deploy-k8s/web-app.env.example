# Copy to web-app.env (or run deploy-k8s/setup-env.sh) before creating the
# k8s secret. Real values are generated locally and never committed.

KEYCLOAK_CLIENT_ID=web
# Populated by infra/local-minikube/keycloak.sh (run via `make keycloak`).
KEYCLOAK_CLIENT_SECRET=
# Browser-facing (redirects) — the NodePort published by bootstrap.sh.
KEYCLOAK_BASE_URL=http://localhost:8081
# Server-side (token exchange, JWKS) — routed over the mesh.
KEYCLOAK_INTERNAL_BASE_URL=http://keycloak.virtual.consul
KEYCLOAK_REALM=demo
KEYCLOAK_REDIRECT_URI=http://localhost:8080/api/auth/callback
KEYCLOAK_LOGOUT_URI=http://localhost:8080/
KEYCLOAK_SCOPES=openid profile email Agent.Invoke
# Random 32-byte base64 secret used to sign the web session cookie.
SESSION_PASSWORD=
AI_AGENT_API_URL=http://ai-agent.default.svc.cluster.local:8000
