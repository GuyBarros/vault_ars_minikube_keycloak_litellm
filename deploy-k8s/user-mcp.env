# ── Database Config ────────────────────────────────────────────────────────────
USER_MCP_PG_URL="postgresql://postgres.default.svc.cluster.local:5432/users?sslmode=disable"
USER_BACKEND=postgres
USER_MCP_DB_AUTH_MODE=vault
USER_MCP_DB_USER=postgres
USER_MCP_DB_PASSWORD="HashiCorp123!"
USER_MCP_AUTO_MIGRATE=true   # optional: lets user-mcp create the table
# ── HTTP / Process ────────────────────────────────────────────────────────────
USER_MCP_HOST=0.0.0.0
USER_MCP_PORT=8090
USER_MCP_PATH=/mcp
USER_MCP_LOG_LEVEL=DEBUG

# ── Auth ──────────────────────────────────────────────────────────────────────
# Keycloak realm base URL, e.g. http://keycloak.virtual.consul/realms/demo
USER_MCP_KEYCLOAK_BASE_URL=http://keycloak.virtual.consul/realms/demo
# Optional: explicit JWKS URL (defaults to {KEYCLOAK_BASE_URL}/protocol/openid-connect/certs)
USER_MCP_KEYCLOAK_JWKS_URL=http://keycloak.virtual.consul/realms/demo/protocol/openid-connect/certs
# Required aud claim value (the resource-server client id in Keycloak)
USER_MCP_AUDIENCE=user-mcp
# Required iss claim value — must match Keycloak's KC_HOSTNAME, i.e. the
# externally-reachable URL (localhost:8081), not the in-cluster JWKS host.
USER_MCP_ISSUER=http://localhost:8081/realms/demo
USER_MCP_JWKS_CACHE_SECONDS=3600
# Set true to skip JWT validation in local dev
USER_MCP_BYPASS_AUTH=false
# Set true to allow tools/list without Authorization header (mesh-secured deploys only)
USER_MCP_ALLOW_UNAUTH_DISCOVERY=true
# runtime = LiteLLM is the PEP (JWT/scope/CIBA). user-mcp trusts the inbound
# bearer, extracts claims without JWKS, and still uses the JWT as X-Vault-Token
# for database/creds + Transform.
USER_MCP_PEP_MODE=runtime

# ── Keycloak CIBA (human-in-the-loop approval on writes) ────────────────────
# The HITL switch is a Vault ACL policy outcome on ciba/<action>/<user> (see
# infra/local-minikube/keycloak.sh) — create/delete = HITL, update/read =
# silent OBO.
USER_MCP_CIBA_KEYCLOAK_URL=http://keycloak.virtual.consul
USER_MCP_CIBA_REALM=demo
USER_MCP_CIBA_CLIENT_ID=ciba-client
# Populated by infra/local-minikube/keycloak.sh (run via `make keycloak`).
USER_MCP_CIBA_CLIENT_SECRET=e7494c84e1487518ae30d711d57d1eaf0c58b63be20c9986
USER_MCP_CIBA_POLL_TIMEOUT_SECONDS=110
USER_MCP_CIBA_APPROVE_URL=http://localhost:8093

# ── Vault ─────────────────────────────────────────────────────────────────────
USER_MCP_VAULT_ADDR=https://vault.vault.svc:8200
USER_MCP_VAULT_NAMESPACE=root
USER_MCP_VAULT_VERIFY_TLS=false
USER_MCP_VAULT_TIMEOUT_SECONDS=10
# jwt-keycloak login is used only to probe the CIBA-required-by-policy ACL
# switch — database/creds and Transform calls present the Keycloak OBO/CIBA
# JWT directly to Vault's OAuth Resource Server (see vault_client.py).
USER_MCP_VAULT_JWT_PATH=jwt-keycloak
USER_MCP_VAULT_JWT_READ_ROLE=user-mcp-oidc-read
USER_MCP_VAULT_JWT_WRITE_ROLE=user-mcp-oidc-write
USER_MCP_VAULT_DB_READ_PATH=database/creds/user-mcp-read-role
USER_MCP_VAULT_DB_WRITE_PATH=database/creds/user-mcp-write-role

# ── Metabase (optional) ───────────────────────────────────────────────────────
# Leave empty to disable Metabase tools
USER_MCP_METABASE_URL=https://tranquil-cray.metabaseapp.com/api/agent
USER_MCP_VAULT_METABASE_JWT_READ_ROLE=user-mcp-read
USER_MCP_VAULT_METABASE_JWT_WRITE_ROLE=user-mcp-write
USER_MCP_VAULT_METABASE_READ_PATH=metabase_api/creds/read-only
USER_MCP_VAULT_METABASE_WRITE_PATH=metabase_api/creds/creators
