# Copy to token-exchange.env (or run deploy-k8s/setup-env.sh) before creating
# the k8s secret. Real values are generated locally and never committed.

IDENTITY_BROKER_KEYCLOAK_URL=http://keycloak.virtual.consul
IDENTITY_BROKER_KEYCLOAK_REALM=demo
IDENTITY_BROKER_KEYCLOAK_TOKEN_EXCHANGE_AUDIENCE=user-mcp
IDENTITY_BROKER_OBO_CLIENT_ID=token-exchange
# Populated by infra/local-minikube/keycloak.sh (run via `make keycloak`),
# which keeps this in sync with the secret baked into the imported realm.
IDENTITY_BROKER_OBO_CLIENT_SECRET=
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
VAULT_ADDR=https://vault.vault.svc.cluster.local:8200
# The actor token is a JWT-SVID from Vault's SPIFFE secrets engine, verified against
# the keys that mount publishes (<issuer>/.well-known/keys, fetched over TLS with the
# CA below). The audience is the one the ai-agent's Vault Agent template asks for.
IDENTITY_BROKER_VAULT_CA_BUNDLE=/etc/vault-ca/ca.crt
IDENTITY_BROKER_ACTOR_ISSUER=https://vault.vault.svc.cluster.local:8200/v1/spiffe
IDENTITY_BROKER_ACTOR_AUDIENCE=agent-actor
