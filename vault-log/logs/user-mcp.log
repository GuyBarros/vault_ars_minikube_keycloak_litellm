tags\":[]}}},{\"name\":\"metabase_construct_query\",\"description\":\"Build a Metabase MBQL query from a portable representation and return it as a base64-encoded string. query must be an MBQL 5 object using portable field references (e.g. [\\\\\"db-name\\\\\", \\\\\"schema\\\\\", \\\\\"table\\\\\", \\\\\"column\\\\\"]). Returns {query: base64-string, prompt?: string}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"query\":{\"additionalProperties\":true,\"type\":\"object\"},\"prompt\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null}},\"required\":[\"query\"],\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\":[\"users.read\"],\"fastmcp\":{\"tags\":[]}}},{\"name\":\"metabase_query\",\"description\":\"Construct and execute an MBQL query in one call, with continuation-token pagination (max 200 rows per page). Provide either query (MBQL object) for the first page, or continuation_token from a prior response to fetch the next page. Returns {status, data?: {cols, rows}, row_count?, running_time?, error?, continuation_token?}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"query\":{\"anyOf\":[{\"additionalProperties\":true,\"type\":\"object\"},{\"type\":\"null\"}],\"default\":null},\"continuation_token\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null}},\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\":[\"users.read\"],\"fastmcp\":{\"tags\":[]}}},{\"name\":\"metabase_execute\",\"description\":\"Execute a base64-encoded MBQL query and return results with column metadata. Obtain the base64 query string from metabase_construct_query first. Returns {status: completed|failed, data?: {cols, rows}, row_count?, running_time?, error?}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\":[\"users.read\"],\"fastmcp\":{\"tags\":[]}}},{\"name\":\"metabase_execute_sql\",\"description\":\"Execute a raw SQL query against a Metabase database. Requires native-query permission for the target database. Returns {status: completed|failed, data?: {cols, rows}, row_count?, running_time?, error?}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"database_id\":{\"type\":\"integer\"},\"sql\":{\"type\":\"string\"}},\"required\":[\"database_id\",\"sql\"],\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\":[\"users.read\"],\"fastmcp\":{\"tags\":[]}}},{\"name\":\"metabase_create_question\",\"description\":\"Save a previously constructed MBQL query as a named question (card) in Metabase. query must be a base64-encoded MBQL string from metabase_construct_query. display controls the chart type (table, bar, line, pie, scatter, area, row, combo, pivot, scalar, smartscalar, gauge, progress, funnel, map, waterfall, sankey). Returns {id, name, url, display, collection_id, collection_path, description}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"name\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"},\"display\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null},\"description\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null},\"collection_id\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}],\"default\":null},\"visualization_settings\":{\"anyOf\":[{\"additionalProperties\":true,\"type\":\"object\"},{\"type\":\"null\"}],\"default\":null}},\"required\":[\"name\",\"query\"],\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\":[\"users.write\"],\"fastmcp\":{\"tags\":[]}}},{\"name\":\"metabase_update_question\",\"description\":\"Update a saved question by ID using patch semantics (only provided fields are changed). query must be a base64-encoded MBQL string if updating the query. Returns {id, name, display, collection_id, collection_path, description, archived}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null},\"description\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null},\"collection_id\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}],\"default\":null},\"display\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null},\"visualization_settings\":{\"anyOf\":[{\"additionalProperties\":true,\"type\":\"object\"},{\"type\":\"null\"}],\"default\":null},\"archived\":{\"anyOf\":[{\"type\":\"boolean\"},{\"type\":\"null\"}],\"default\":null},\"query\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null}},\"required\":[\"id\"],\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\":[\"users.write\"],\"fastmcp\":{\"tags\":[]}}},{\"name\":\"metabase_create_dashboard\",\"description\":\"Create a new Metabase dashboard, optionally pre-populated with saved questions. question_ids is a list of question IDs to add as dashcards. Returns {id, name, url, collection_id, collection_path, description, dashcard_ids}.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"name\":{\"type\":\"string\"},\"description\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null},\"collection_id\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}],\"default\":null},\"question_ids\":{\"anyOf\":[{\"items\":{\"type\":\"integer\"},\"type\":\"array\"},{\"type\":\"null\"}],\"default\":null}},\"required\":[\"name\"],\"type\":\"object\"},\"outputSchema\":{\"additionalProperties\":true,\"type\":\"object\"},\"_meta\":{\"required_scopes\"