apiVersion: v1
kind: Secret
metadata:
  name: ${secret_name}
  namespace: ${namespace}
type: Opaque
stringData:
  POSTGRES_USER: "${admin_user}"
  POSTGRES_PASSWORD: "${admin_password}"
  POSTGRES_DB: "${admin_db}"
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: ${statefulset_name}
  namespace: ${namespace}
spec:
  serviceName: ${service_name}
  replicas: 1
  selector:
    matchLabels:
      app: ${app_label}
  template:
    metadata:
      labels:
        app: ${app_label}
      annotations:
        consul.hashicorp.com/connect-inject: "true"
        consul.hashicorp.com/enable-metrics-merging: "false"
    spec:
      serviceAccountName: ${service_name}
      containers:
        - name: postgres
          image: postgres:16
          ports:
            - containerPort: 5432
          env:
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          envFrom:
            - secretRef:
                name: ${secret_name}
          volumeMounts:
            - name: postgresdb-data
              mountPath: /var/lib/postgresql/data
  volumeClaimTemplates:
    - metadata:
        name: postgresdb-data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: standard
        resources:
          requests:
            storage: 5Gi
---
# Consul requires the ServiceAccount name to equal the mesh service name (ACLs on).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${service_name}
  namespace: ${namespace}
---
apiVersion: v1
kind: Service
metadata:
  name: ${service_name}
  namespace: ${namespace}
spec:
  type: ClusterIP
  selector:
    app: ${app_label}
  ports:
    - protocol: TCP
      port: 5432
      targetPort: 5432
